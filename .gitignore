# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/

# ── ML artifacts (keep folder structure, ignore binary/data content) ──────────
artifacts/models/*.joblib
artifacts/models/*.pkl
artifacts/models/*.pickle
artifacts/models/registry.json
artifacts/metrics/*.json
artifacts/plots/*.png
artifacts/plots/*.jpg
artifacts/plots/*.svg
artifacts/monitoring/*.jsonl
artifacts/monitoring/*.log

# ── Data ──────────────────────────────────────────────────────────────────────
data/raw/*.csv
data/raw/*.json
data/raw/*.parquet
data/processed/*.csv
data/processed/*.json
data/processed/metadata.json

# ── Logs & temp ───────────────────────────────────────────────────────────────
*.log
logs/
*.tmp
*.bak
/tmp/neuralnexus_start.txt

# ── Tests & coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
._*
